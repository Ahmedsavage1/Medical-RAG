{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GroundedAnswerResponse",
  "type": "object",
  "required": ["recommendation", "evidence", "citations", "confidence"],
  "properties": {
    "recommendation": {
      "type": "string",
      "minLength": 1,
      "description": "The final answer text, or a plain refusal when confidence is 'insufficient'."
    },
    "evidence": {
      "type": "string",
      "description": "Verbatim (or near-verbatim) supporting text pulled from the retrieved chunk(s)."
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "section", "page_number", "chunk_id"],
        "properties": {
          "document_id": { "type": "string" },
          "section": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "chunk_id": { "type": "string" }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "insufficient"]
    },
    "flags": {
      "type": "array",
      "description": "Optional safety/refusal tags, e.g. 'patient_specific_dosing_blocked'.",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "comment": "Rule: any confidence other than 'insufficient' MUST carry non-empty evidence and >=1 citation. This is the structural enforcement of 'never invent, never guess'.",
      "if": {
        "properties": { "confidence": { "enum": ["high", "medium", "low"] } }
      },
      "then": {
        "properties": {
          "evidence": { "minLength": 1 },
          "citations": { "minItems": 1 }
        }
      }
    },
    {
      "comment": "Rule: 'insufficient' confidence MUST have empty evidence and zero citations - no hedged half-answers.",
      "if": {
        "properties": { "confidence": { "const": "insufficient" } }
      },
      "then": {
        "properties": {
          "evidence": { "maxLength": 0 },
          "citations": { "maxItems": 0 }
        }
      }
    }
  ]
}